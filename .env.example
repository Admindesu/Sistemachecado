# Copiar a .env y cambiar las contraseñas antes de usar
APP_PORT=8080
PMA_PORT=8081
APP_TZ=America/Cancun

DB_NAME=sis-asistencia
DB_USER=checador
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root

# --- Terminal Hikvision ---
# IP del dispositivo en la red local (192.168.0.0/24)
HIK_HOST=192.168.0.50
HIK_USUARIO=admin
HIK_PASSWORD=clave_del_dispositivo
# Token secreto para la URL de HTTP Listening (generar uno largo y aleatorio)
HIK_PUSH_TOKEN=cambia_este_token
# IPs desde las que se aceptan envíos (vacío = cualquiera con el token).
# Con Docker Desktop en Windows la IP de origen se ve como la del gateway; dejar vacío ahí.
HIK_IPS_PERMITIDAS=
# Subtipos de evento que cuentan como marcaje: 1 tarjeta, 38 huella, 75 rostro
HIK_MINORS_VALIDOS=1,38,75
# Cada cuántos segundos se consulta el dispositivo
HIK_INTERVALO_SEG=300
# Días hacia atrás que se descargan la primera vez
HIK_DIAS_INICIALES=7
